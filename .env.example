# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Apenas backend, nunca expor

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
APP_ENV=development                 # development | staging | production
SECRET_KEY=change-me
HUB_PUBLICO=false                   # true no deploy (Render) p/ os assinantes acessarem o hub

# W-API (WhatsApp)
WAPI_BASE_URL=https://api.w-api.app/v1
WAPI_TOKEN=seu-token-da-instancia
WAPI_INSTANCE_ID=SEU-INSTANCE-ID
WAPI_API_KEY=WAPI-XXXX-XXXX-XXXX-XXXX

# Mercado Pago (Pix para o módulo de Rifas)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-XXXX
MERCADO_PAGO_PUBLIC_KEY=APP_USR-XXXX   # usado só se ativar o Payment Brick no front
MERCADO_PAGO_WEBHOOK_URL=

# Token de proteção do painel admin (Bearer)
ADMIN_TOKEN=

# Composio (conectores dos escritórios via OAuth gerenciado)
COMPOSIO_API_KEY=ak_XXXX
COMPOSIO_GDRIVE_AUTH_CONFIG_ID=ac_XXXX
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3
# Demais toolkits Google (auth configs ac_...) — podem reusar a MESMA credencial OAuth do Drive
COMPOSIO_GCALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GDOCS_AUTH_CONFIG_ID=
COMPOSIO_GSHEETS_AUTH_CONFIG_ID=
COMPOSIO_GMEET_AUTH_CONFIG_ID=

# mcp.ai ("Banco MCP") — EasyJur + Tiflux (Workspace API key sk_live_...)
MCP_AI_API_KEY=
MCP_AI_BASE_URL=https://api.mcp.ai
